<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: CMake fills in the release list from CHANGELOG.md. -->
<component type="desktop-application">
  <id>io.github.markdown_glass</id>
  <name>Markdown Glass</name>
  <summary>View markdown files</summary>
  <developer id="io.github.fingerlessglov3s">
    <name>FingerlessGloves</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause</project_license>
  <description>
    <p>
      Markdown Glass is a read-only viewer for markdown files. It renders
      GitHub Flavored Markdown in a native Qt window that follows your desktop
      colour scheme.
    </p>
    <ul>
      <li>One-click copy for code blocks and inline code</li>
      <li>Syntax highlighting for fenced code blocks that name a language</li>
      <li>Outline sidebar and a document preview on the scrollbar</li>
      <li>Optional reading width limit and code block wrapping</li>
      <li>Remote images blocked until you allow them</li>
      <li>Printing, find, tabs and automatic reload</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/FingerlessGlov3s/markdown-glass</url>
  <url type="bugtracker">https://github.com/FingerlessGlov3s/markdown-glass/issues</url>
  <launchable type="desktop-id">io.github.markdown_glass.desktop</launchable>
  <provides>
    <binary>markdown-glass</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
@RELEASES@
  </releases>
</component>
